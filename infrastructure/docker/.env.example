# Copy to .env and replace every secret before using the stack.
# Hostnames are loopback-only by default. Use TLS at an authenticated ingress in production.
COMPOSE_PROJECT_NAME=cavom-devsecops

GITLAB_HTTP_PORT=8080
GITLAB_SSH_PORT=2222
GITLAB_REGISTRY_PORT=5050
SONARQUBE_HTTP_PORT=9000

GITLAB_EXTERNAL_URL=http://gitlab.localhost:8080
GITLAB_REGISTRY_EXTERNAL_URL=http://registry.localhost:5050
GITLAB_ROOT_PASSWORD=replace-with-a-unique-random-value-at-least-32-characters

POSTGRES_USER=sonar
POSTGRES_DB=sonar
POSTGRES_PASSWORD=replace-with-a-unique-random-database-password

# Point this at an untracked config.toml copied from runner/config.toml.example.
GITLAB_RUNNER_CONFIG=./runner/config.toml
