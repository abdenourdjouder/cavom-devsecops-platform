concurrent = 2
check_interval = 3
shutdown_timeout = 30
log_level = "warning"

[[runners]]
  name = "cavom-docker-executor"
  url = "https://gitlab/"
  clone_url = "https://gitlab/"
  token = "replace-with-a-gitlab-runner-authentication-token"
  executor = "docker"
  tls-ca-file = "/etc/gitlab-runner/certs/gitlab.localhost.crt"
  limit = 2

  [runners.docker]
    host = "tcp://rootless-docker-endpoint:2376"
    tls_verify = true
    image = "debian:bookworm-20250317-slim"
    privileged = false
    disable_entrypoint_overwrite = false
    oom_kill_disable = false
    cap_drop = ["ALL"]
    security_opt = ["no-new-privileges=true"]
    shm_size = 268435456
    volumes = ["/cache"]

  [runners.cache]
    Type = "local"
    Shared = false
